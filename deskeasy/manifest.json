{
  "manifest_version": 3,
  "name": "DeskEasy",
  "version": "1.0.4",
  "version_name": "1.0.4",
  "description": "Toolkit for Frappe & ERPNext v15/v16: X-Ray, Glance preview, AI Magic Filler, Data Teleport, Quick Customize and more.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*/app*", "*://*/desk*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}