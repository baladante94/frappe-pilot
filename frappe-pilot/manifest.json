{
  "manifest_version": 3,
  "name": "Frappe Pilot",
  "version": "1.0",
  "description": "Developer toolkit for Frappe & ERPNext v15/v16: X-Ray, AI Magic Filler, Data Teleport, Quick Customize, Link Peek and more.",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*/app*", "*://*/desk*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}